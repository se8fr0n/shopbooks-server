# Copy this file to .env and fill it in. Never share or upload .env.
DATABASE_URL=postgres://user:password@localhost:5432/shopbooks
# Set to 1 when your host (Neon, Supabase, Render) requires SSL
PGSSL=0
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000
